# Copy to .env (or use scripts/switch-supabase.sh test|prod) and fill with real values.
# PERMANENT RULE: no environment defaults in source code. The app refuses to start
# without ALL of these. See docs/ENV.md.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-upload-preset
VITE_APP_DEEPLINK_BASE=cluvo://
VITE_APP_URL=https://your-app.vercel.app
