# Template for local `supabase functions serve` / `supabase secrets set`.
# PERMANENT RULE: no environment defaults in source code. Edge functions fail fast
# on missing required secrets (see supabase/functions/_shared/env.ts). Every value
# is per-project: set in the TEST project AND the PROD project separately via
# `supabase secrets set --env-file .env --project-ref <ref>`.
# See docs/ENV.md.

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ACCESS_TOKEN=your-access-token
SUPABASE_JWT_SECRET=your-jwt-secret

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Cashfree Payout
CASHFREE_CLIENT_ID=your-cashfree-client-id
CASHFREE_CLIENT_SECRET=your-cashfree-client-secret
CASHFREE_WEBHOOK_SECRET=your-cashfree-webhook-secret
CASHFREE_PUBLIC_KEY=your-cashfree-public-key
CASHFREE_ENV=sandbox

# SMTP — local `supabase start` only (see docs/ENV.md "Forgot-password email").
# Hosted TEST/PROD projects do NOT read these: configure SMTP in the Supabase
# Dashboard (Authentication -> Emails -> SMTP Settings) for each project.
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_EMAIL=
